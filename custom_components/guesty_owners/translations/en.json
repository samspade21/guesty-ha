{
  "config": {
    "step": {
      "user": {
        "title": "Guesty Owners Portal",
        "description": "Sign in with the same details you use on your property manager's owners portal. The integration only reads data.",
        "data": {
          "host": "Portal address",
          "username": "Email",
          "password": "Password"
        },
        "data_description": {
          "host": "The address you open to reach the portal, such as acme.guestyowners.com. The name before .guestyowners.com is enough.",
          "username": "The email address you sign in to the portal with.",
          "password": "Your portal password. It is stored in Home Assistant so the integration can sign in again when the session expires."
        }
      },
      "reauth_confirm": {
        "title": "Sign in again",
        "description": "The portal {portal} no longer accepts the saved password for {username}.",
        "data": {
          "password": "Password"
        },
        "data_description": {
          "password": "Your current portal password."
        }
      },
      "reconfigure": {
        "title": "Update portal login",
        "description": "Change the portal address or the login. It must be the same owner account.",
        "data": {
          "host": "Portal address",
          "username": "Email",
          "password": "Password"
        },
        "data_description": {
          "host": "The address you open to reach the portal, such as acme.guestyowners.com.",
          "username": "The email address you sign in to the portal with.",
          "password": "Your portal password."
        }
      }
    },
    "error": {
      "cannot_connect": "Could not reach Guesty. Check your internet connection and try again.",
      "invalid_auth": "The email or password is wrong.",
      "invalid_host": "That does not look like a portal address.",
      "portal_not_found": "No owners portal was found at that address.",
      "unknown": "Guesty returned something unexpected. See the log for details."
    },
    "abort": {
      "already_configured": "This owner account is already set up.",
      "wrong_account": "Those details belong to a different owner account. Add it as a new entry instead."
    }
  },
  "options": {
